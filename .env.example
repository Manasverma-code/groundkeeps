# ── Target LLM (the model behind the proxy) ──────────
# Options: openai, anthropic, gemini, groq, deepseek, together, openrouter, ollama
TARGET_LLM_PROVIDER=openai
TARGET_LLM_API_KEY=sk-...
TARGET_LLM_MODEL=gpt-4o-mini
# TARGET_LLM_BASE_URL=  # custom base URL (optional)

# ── Verifier LLM (grounding engine's fact-checker) ──
# Can be same or different provider
VERIFIER_LLM_PROVIDER=groq
VERIFIER_LLM_API_KEY=gsk_...
VERIFIER_LLM_MODEL=llama-3.3-70b-versatile

# ── Proxy ────────────────────────────────────────────
PROXY_PORT=3000
