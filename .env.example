# ── Target LLM (the model behind the proxy) ──────────
# Options: openai, anthropic, gemini, groq, deepseek, together, openrouter, ollama
TARGET_LLM_PROVIDER=ollama
TARGET_LLM_API_KEY=
TARGET_LLM_MODEL=llama3.2
# TARGET_LLM_BASE_URL=http://host.docker.internal:11434/v1  # Docker + local Ollama

# ── Verifier LLM (grounding engine's fact-checker) ──
# Can be same or different provider
VERIFIER_LLM_PROVIDER=ollama
VERIFIER_LLM_API_KEY=
VERIFIER_LLM_MODEL=llama3.2

# ── Security ────────────────────────────────────────
# Set this to require an API key on every request to the proxy.
# Leave empty to allow unauthenticated access (development only).
# PROXY_API_KEY=gk_secret_key_here

# ── Proxy ────────────────────────────────────────────
PROXY_PORT=3000
AUDIT_DB_PATH=./data/audit.db
DEFAULT_AGENT_ID=default
