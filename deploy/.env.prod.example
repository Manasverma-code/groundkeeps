# ── Domain Configuration ────────────────────────────
# Your domain name (e.g., api.ground-keeps.com)
DOMAIN=your-domain.com

# Email for Let's Encrypt certificate notifications
EMAIL=admin@your-domain.com

# ── Security ────────────────────────────────────────
# Generate a strong API key: openssl rand -hex 32
PROXY_API_KEY=gk_change_this_to_a_random_key

# ── LLM Providers ───────────────────────────────────
# Options: openai, anthropic, gemini, groq, deepseek, together, openrouter, ollama
TARGET_LLM_PROVIDER=groq
TARGET_LLM_API_KEY=gsk_your_groq_key
TARGET_LLM_MODEL=llama-3.3-70b-versatile

VERIFIER_LLM_PROVIDER=groq
VERIFIER_LLM_API_KEY=gsk_your_groq_key
VERIFIER_LLM_MODEL=llama-3.3-70b-versatile

# ── Storage ─────────────────────────────────────────
AUDIT_DB_PATH=/data/audit.db
